{
  "name": "guanxin-my-heart",
  "private": true,
  "version": "1.2.0",
  "description": "观心 - 温暖的心理陪伴与情绪解压空间",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "dev:full": "concurrently -k -n API,WEB -c green,cyan \"npm:server\" \"npm:dev\"",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "seed:export": "node scripts/export-seed.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.70.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
